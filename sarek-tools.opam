# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "dev"
synopsis: "Command-line tools for Sarek (sarek-device-info)"
description: """
sarek-device-info lists the devices of every Sarek backend installed
alongside it: Native and Interpreter always, and CUDA, HIP, OpenCL, Vulkan or
Metal when the corresponding sarek-* package is installed."""
maintainer: ["mathias.bourgoin@gmail.com"]
authors: ["Mathias Bourgoin"]
license: "Cecill-B"
homepage: "https://github.com/mathiasbourgoin/Sarek"
bug-reports: "https://github.com/mathiasbourgoin/Sarek/issues"
depends: [
  "dune" {>= "3.15"}
  "ocaml" {>= "5.4.0"}
  "sarek" {= version}
  "odoc" {with-doc}
]
depopts: [
  "sarek-cuda" "sarek-hip" "sarek-opencl" "sarek-vulkan" "sarek-metal"
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mathiasbourgoin/Sarek.git"
