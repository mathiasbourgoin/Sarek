#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

// Sarek-generated compute shader: cm_i32
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set=0, binding = 0) buffer Buffer_a {
  uint8_t a[];
};
layout(std430, set=0, binding = 1) buffer Buffer_b {
  uint8_t b[];
};
layout(std430, set=0, binding = 2) buffer Buffer_c {
  int c[];
};
layout(std430, set=0, binding = 3) buffer Buffer_d {
  int d[];
};
layout(push_constant) uniform PushConstants {
  int sarek_a_length;
  int sarek_b_length;
  int sarek_c_length;
  int sarek_d_length;
} pc;

#define sarek_a_length pc.sarek_a_length
#define sarek_b_length pc.sarek_b_length
#define sarek_c_length pc.sarek_c_length
#define sarek_d_length pc.sarek_d_length

void main() {
  coopmat<uint8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> fa = coopmat<uint8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>(0);
  coopmat<uint8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fb = coopmat<uint8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>(0);
  coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> fc = coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
  coopMatLoad(fa, a, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
  coopMatLoad(fb, b, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
  coopMatLoad(fc, c, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
  fc = coopMatMulAdd(fa, fb, fc);
  coopMatStore(fc, d, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
}
