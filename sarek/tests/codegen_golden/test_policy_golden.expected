/* Sarek: Sarek_f16_policy.accept_single_rounding covers this kernel: its f32->f16 narrowings carry no barrier and may round once where the interpreter rounds twice (specs/f16-narrowing-barrier.md). */

extern "C" {
__global__ void q4k_like(__half* __restrict__ out, int sarek_out_length, __half* __restrict__ h, int sarek_h_length, __half* __restrict__ g, int sarek_g_length, int* __restrict__ q, int sarek_q_length, float* __restrict__ x, int sarek_x_length) {
