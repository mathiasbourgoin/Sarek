; f16 is a storage-only type: no operator may see it (#57 slice 1 review, MF4).
; test_f16_equality is the one that COMPILED before the fix — the Eq/Ne arm of
; infer_binop skipped every numeric check and emitted `==` on `__half`.

(library
 (name neg_test_f16_arith)
 (modules test_f16_arith)
 (libraries sarek sarek.stdlib sarek.ppx.lib)
 (preprocess
  (pps sarek_ppx))
 (flags
  (:standard -w -33))
 (enabled_if
  (= %{profile} "negative")))

(library
 (name neg_test_f16_equality)
