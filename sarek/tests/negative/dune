; A SCALAR f16 parameter (as opposed to a `float16 vector`) silently produced
; garbage on HIP/CUDA: there is no float16 arg constructor, so it could only be
; fed a 4-byte float whose low 2 bytes the device read as a __half.

(library
 (name neg_test_f16_scalar_param)
 (modules test_f16_scalar_param)
 (libraries sarek sarek.stdlib sarek.ppx.lib)
 (preprocess
  (pps sarek_ppx))
 (flags
  (:standard -w -33))
 (enabled_if
  (= %{profile} "negative")))

; f16 arithmetic reached through let-polymorphic generalization: the guard is
; keyed by tvar id, and copy_for_scheme/instantiate mint fresh ids. Before the
; fix the typer accepted this outright.

