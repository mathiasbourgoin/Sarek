; Negative tests - verify expected compile errors
;
; These files intentionally contain errors to test error detection.
; Disabled by default; enabled via --profile=negative
;
; Run via: make test_negative
;
; Expected errors:
; - test_barrier_diverged: "Barrier called in diverged control flow"
; - test_superstep_diverged: "Barrier called in diverged control flow"
; - test_warp_diverged: "Warp collective 'warp_shuffle' called in diverged control flow"
; - test_unbound_function: "Unbound variable"
; - test_reserved_keyword: "'double' is a reserved C/CUDA/OpenCL keyword"
; - test_convention_kernel_fail: "Field z not found"
; - test_convention_kernel_fail2: "Cannot unify types"
; - test_inline_node_exhaustion: "Inlining produced N nodes (limit: 10000)"
; - test_tuple_param: "Tuple-typed kernel parameters are not supported"
; - test_shared_tuple: "Tuple-typed shared-memory arrays are not supported"
; - test_tuple_local_nonprim: "Tuple values support only scalar components"
; - test_tuple_destructure_nonprim: "Tuple values support only scalar components"
; - test_tuple_expr_nonprim: "Tuple values support only scalar components"
;   (backlog-194: pins the TETuple lowering arm itself -- no equality involved)
; - test_tuple_eq_nonprim: "cannot compare two values of type" (backlog-194)
; - test_tuple_eq_prim: "cannot compare two values of type" (backlog-194)
; - test_record_eq: "cannot compare two values of type" (backlog-194)
; - test_variant_neq: "'<>' cannot compare two values of type" (backlog-194:
;   the third member of the refused set, and the only <> case)
; - test_fun_eq: "'=' cannot compare two function values" (backlog-194: the
;   fourth member; a different diagnostic because the failure is different)
; - test_poly_aggregate_eq: "cannot compare two values of type" AND "Refused at
;   lowering" (backlog-194: the post-monomorphisation backstop, which the typer
;   gate cannot reach). The three cases above assert the same text and the
;   ABSENCE of that second string -- both gates print the shared sentence, so
;   without the negative half they would pass with the typer gate deleted.
; - test_fun_param: "Function-typed kernel parameters are not supported"
; - test_fun_escape: "Function value escapes"
; - test_sarek_type_extension: "Uninterpreted extension 'sarek.type'"
; - test_unregistered_field: "unknown size/alignment for field type"
; - test_ktype_advice: "declare it with [@@sarek.type]" (backlog-193: the
;   advice, not just the refusal -- the message named a nonexistent [%%ktype])
; - test_sarek_include_advice: "[%%sarek_include] expects a string path"
;   (backlog-193 second sweep: the advice rendered as single-% [%sarek_include],
;   which is not this extension -- see the case header)
; - test_reserved_prefix_param: "identifiers beginning with 'sarek_' are reserved"
; - test_reserved_prefix_local: "identifiers beginning with 'sarek_' are reserved"
; - test_reserved_prefix_helper: "identifiers beginning with 'sarek_' are reserved"
; - test_reserved_prefix_field: "identifiers beginning with 'sarek_' are reserved"
; - test_reserved_prefix_for: "identifiers beginning with 'sarek_' are reserved"
; - test_f16_arith:    "float16 is a storage-only type and has no arithmetic"
; - test_f16_equality: "float16 is a storage-only type and has no arithmetic"
; - test_f16_compare:  "float16 is a storage-only type and has no arithmetic"
; - test_f16_scalar_param: "cannot be a scalar kernel parameter"
; - test_f16_poly_helper: "a polymorphic helper instantiated at float16"
; - test_char_vector: "`char` is not a supported Sarek element type"
; - test_poly_helper_f64: "'norm' cannot be used at this call site"
; - test_when_guard: "`when` guards on match cases are not supported in kernels"
; - test_inline_type_field_store: "cannot assign to field ... of a record type
;   declared inside the kernel" + "register it with [@@sarek.type]"
; - test_record_update: "functional record update" (backlog-192)
; - test_whole_binding_annotation: "whole-binding type annotation on a function" (backlog-192)
; - test_return_annotation_arity: "fewer arrows than the function has parameters" (backlog-192)
; - test_double_annotation: "annotated twice" (backlog-192)
; - test_two_result_annotations: "two result annotations" (backlog-192)
; - test_payload_type_nonrec: "`type nonrec` is not supported" (backlog-192)
; - test_labelled_arg: "labelled or optional argument" (backlog-192)
; - test_kernel_return_type: "return-type annotation on a kernel" (backlog-192)
; - test_tuple_let_annotation: "type annotation on a tuple-pattern" (backlog-192)
; - test_module_const_no_type: "needs a type annotation" (backlog-192)
; - test_module_item_dropped: "exception declaration is not supported in a kernel module" (backlog-192)
; - test_module_not_structure: "only a literal structure is supported here" (backlog-192)
; - test_payload_type_params: "parameterised type" (backlog-192)
; - test_payload_type_alias: "a type alias" (backlog-192)
; - test_payload_gadt: "GADT-style constructor declaration" (backlog-192)
; - test_wildcard_type: "wildcard type annotation" (backlog-192)
; - test_labelled_arrow_type: "labelled or optional argument in a function type" (backlog-192)
; - test_functor_type_path: "functor application in a type path" (backlog-192)
; - test_alias_binder: "as` alias in a kernel binder" (backlog-192)
; - test_binding_coercion: "coercion on a `let` binding" (backlog-192)
; - test_return_coercion: "coercion in a function's return position" (backlog-192)
; - test_existential_pattern: "existential type binder" (backlog-192)
; - test_superstep_attribute: "on a superstep binding is not interpreted" (backlog-192)
; - test_local_annotation_read: "Cannot unify types" (backlog-192)
; - test_helper_return_read: "Cannot unify types" (backlog-192)
; - test_nested_fun_return_read: "Cannot unify types" (backlog-192)
; - test_module_helper_return_read: "Cannot unify types" (backlog-192)
; - test_expr_table_try: "try ... with` is not supported in kernels" (backlog-192)
; - test_pattern_table_or: "or-pattern" (backlog-192)

(library
 (name neg_test_unregistered_field)
 (modules test_unregistered_field)
 (libraries sarek sarek.stdlib sarek.ppx.lib)
 (preprocess
  (pps sarek_ppx))
 (flags
  (:standard -w -33))
 (enabled_if
  (= %{profile} "negative")))

