; backlog-180 (H3): a helper PARAMETER colliding with a module constant the
; helper needs transitively (through another constant's initializer). This is the
; one shape the H3 fix turned into a hard rejection rather than a correction, so
; it is the half of that fix no running test can observe.

(library
 (name neg_test_helper_param_shadows_const)
 (modules test_helper_param_shadows_const)
 ; spoc_core is listed because this case actually USES it (the vector type), so
 ; that a guard that stops firing yields a clean compile rather than an unbound
 ; module from a sibling's copied preamble.
 (libraries sarek sarek.stdlib sarek.ppx.lib spoc_core)
 (preprocess
  (pps sarek_ppx))
 (flags
  (:standard -w -33))
 (enabled_if
  (= %{profile} "negative")))

; backlog-193: the unregistered-field refusal advertised [%%ktype], which does
; not exist. test_unregistered_field asserts the refusal; this asserts the
; ADVICE, including the "@@" that Format would otherwise collapse to "@".
; Self-contained on purpose (no `open`) -- see the header comment.

(library
 (name neg_test_ktype_advice)
 (modules test_ktype_advice)
 (libraries sarek sarek.stdlib sarek.ppx.lib)
 (preprocess
  (pps sarek_ppx))
 (flags
  (:standard -w -33))
 (enabled_if
  (= %{profile} "negative")))

; backlog-193 (second sweep): the sarek_include payload refusal named
; [%%sarek_include "file.ml"] in a Format string, so it reached the user as
; [%sarek_include "file.ml"] -- a spelling the extension does not answer to,
; because it is declared in structure_item context. Asserts the ADVICE.
; Self-contained on purpose (no `open`) -- see the header comment.

(library
 (name neg_test_sarek_include_advice)
 (modules test_sarek_include_advice)
 (libraries sarek sarek.stdlib sarek.ppx.lib)
 (preprocess
  (pps sarek_ppx))
 (flags
  (:standard -w -33))
 (enabled_if
  (= %{profile} "negative")))

; backlog-172: a field store into a record type declared INSIDE the kernel is
; refused -- such a type is read through a generated first-class-module getter
; and has no setter. Asserts the refusal AND its ADVICE, including the "@@"
; that Format would otherwise collapse to "@" (same class as the two cases
; above). Self-contained on purpose (no `open`) -- see the header comment.

(library
 (name neg_test_inline_type_field_store)
 (modules test_inline_type_field_store)
 (libraries sarek sarek.stdlib sarek.ppx.lib)
 (preprocess
  (pps sarek_ppx))
 (flags
  (:standard -w -33))
 (enabled_if
  (= %{profile} "negative")))

