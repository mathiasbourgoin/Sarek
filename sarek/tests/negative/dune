; A polymorphic [@sarek.module] helper whose body uses a float32-only stdlib
; intrinsic, instantiated at float64 (#97). The rejection is correct; what was
; wrong was the rendering (unrelated source bytes, from a location that had
; lost pos_bol) and the message (no callee named).

(library
 (name neg_test_poly_helper_f64)
 (modules test_poly_helper_f64)
 (libraries sarek sarek.stdlib sarek.ppx.lib)
 (preprocess
  (pps sarek_ppx))
 (flags
  (:standard -w -33))
 (enabled_if
  (= %{profile} "negative")))

; A `when` guard on a match case (backlog-191). Sarek_parse's Pexp_match arm
; never read pc_guard, so the guard was dropped in the PARSER — upstream of the
; typer, of every lowering pass and of backend selection. The guard here is
; load-bearing, so before the fix this kernel compiled with no diagnostic and
; returned the dropped-guard answer on all 9 devices present. Self-contained on
; purpose (no `open Spoc`/`open Kirc` — backlog-208).

(library
 (name neg_test_when_guard)
 (modules test_when_guard)
 (libraries sarek sarek.stdlib sarek.ppx.lib)
 (preprocess
  (pps sarek_ppx))
 (flags
  (:standard -w -33))
 (enabled_if
  (= %{profile} "negative")))

