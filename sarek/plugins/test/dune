; An out-of-tree consumer must be able to link the CPU backends from the
; install tree: install_consumer.t builds a fresh dune project against the
; installed copy of package sarek (third-party deps still come from the switch,
; where sarek is not installed), so a library that is not installed -- no
; public_name -- cannot resolve. The (package ...) deps both build that install
; tree and, from dune 3.25 on (ocaml/dune#14373), are what put it on the
; action's OCAMLPATH: sarek for the libraries the consumer names, spoc for the
; spoc.* libraries they require.

(cram
 (applies_to install_consumer)
 (deps
  (package spoc)
  (package sarek)))
