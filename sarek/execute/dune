; Execute and Execute_error — extracted from sarek/sarek so that a jsoo target
; can link sarek_execute against a ctypes-free spoc_core instance.
; -open Sarek_interp exposes Sarek_interp's modules unqualified so Execute.ml
; can reference Sarek_ir_interp.* / Sarek_type_helpers.* without changes.

(library
 (name sarek_execute)
 (public_name sarek.execute)
 (flags
  (:standard -open Sarek_interp))
 (libraries
  spoc_framework
  spoc_framework_registry
  spoc_core
  sarek_ir
  sarek_registry
  sarek_interp)
 (modules
  Ir_memo
  Policy_stamp
  Kernel_access
  Index_slice
  Index_bitset
  Coverage_affine
  Ir_rename
  Fusion_horizontal
  Fusion_epilogue
  Launch_limits
  Window_gate
  Launch_window
  Launch_policy
  Epilogue_policy
  Launch_epilogue
  Matrix_admission
  Matrix_specialise
  Coopmat_variant
  Execute
  Execute_error
  Soa_launch)
 (preprocess no_preprocessing)
 (instrumentation
  (backend bisect_ppx)))
