; Fixture for scripts/check-test-alias-coverage.sh's prove-red spec: one target
; wired to runtest, which must NOT be reported.
(executable
 (name fixture_wired))

(rule
 (alias runtest)
 (action
  (run %{dep:fixture_wired.exe})))

; A NON-self-executing alias: dune will not run it on its own, so it is only
; reachable if some invoker (Makefile / workflow / script) builds it. This is
; what gives DIRECTION 3 -- alias reachability -- real content in the fixture,
; rather than a direction that silently does not apply.
(rule
 (alias e2e-fixture)
 (action
  (run %{dep:fixture_wired.exe})))
