/index.html#type-vk_buffer\">Vulkan_types.vk_buffer</a> <span class=\"arrow\">&#45;&gt;</span></span>\u000A  <span><span class=\"label\">src_offset</span>:int <span class=\"arrow\">&#45;&gt;</span></span>\u000A  <span><span class=\"label\">dst_offset</span>:int <span class=\"arrow\">&#45;&gt;</span></span>\u000A  <span><span class=\"label\">byte_size</span>:int <span class=\"arrow\">&#45;&gt;</span></span>\u000A  unit</span></code></div></div><div class=\"odoc-spec\"><div class=\"spec value anchored\" id=\"val-host_to_device\"><a href=\"#val-host_to_device\" class=\"anchor\"></a><code><span><span class=\"keyword\">val</span> host_to_device : \u000A  <span><span class=\"label\">src_ptr</span>:nativeint <span class=\"arrow\">&#45;&gt;</span></span>\u000A  <span><span class=\"label\">dst</span>:<span><span class=\"type-var\">'a</span> <a href=\"../Vulkan_api_memory/index.html#type-buffer\">Memory.buffer</a></span> <span class=\"arrow\">&#45;&gt;</span></span>\u000A  <span><span class=\"label\">dst_offset</span>:int <span class=\"arrow\">&#45;&gt;</span></span>\u000A  <span><span class=\"label\">byte_size</span>:int <span class=\"arrow\">&#45;&gt;</span></span>\u000A  unit</span></code></div><div class=\"spec-doc\"><p><code>byte_size</code> bytes from raw host address <code>src_ptr</code> to <code>dst_offset</code> of <code>dst</code>.</p></div></div><div class=\"odoc-spec\"><div class=\"spec value anchored\" id=\"val-device_to_host\"><a href=\"#val-device_to_host\" class=\"anchor\"></a><code><span><span class=\"keyword\">val</span> device_to_host : \u000A  <span><span class=\"label\">src</span>:<span><span class=\"type-var\">'a</span> <a href=\"../Vulkan_api_memory/index.html#type-buffer\">Memory.buffer</a></span> <span class=\"arrow\">&#45;&gt;</span></span>\u000A  <span><span class=\"label\">src_offset</span>:int <span class=\"arrow\">&#45;&gt;</span></span>\u000A  <span><span class=\"label\">dst_ptr</span>:nativeint <span class=\"arrow\">&#45;&gt;</span></span>\u000